# Application Settings
APP_NAME=Shadow AI Detector - Traffic Analyzer
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# CORS (JSON string array or comma-separated list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:8000"]

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=shadow_ai_detector
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/shadow_ai_detector

# Optional Database Pool Configuration
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
